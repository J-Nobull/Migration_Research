# API Keys for Migration Research
# Copy this file to .env and replace your_key_here with your registered keys

# Bureau of Economic Analysis
# Register for key at: https://apps.bea.gov/API/signup/
BEA_API_KEY = 'your_key_here'

# U.S. Census Bureau
# Register for key at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY = 'your_key_here'

# Bureau of Labor Statistics
# Register for key at: https://data.bls.gov/registrationEngine/
BLS_API_KEY = 'your_key_here'
